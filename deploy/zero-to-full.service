[Unit]
Description=zero-to-full FastAPI 后端
After=network.target

[Service]
Type=simple
# 用部署用户运行（DEPLOY.md 第 4 步会用 sed 替换成你的登录名）
User=YOUR_USER
WorkingDirectory=/opt/zero-to-full/backend
ExecStart=/opt/zero-to-full/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
