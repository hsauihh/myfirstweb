  "cards": [
    {
      "dot": "cyan",
      "title": "运行形态",
      "items": [
        "前端 Next.js 静态导出，nginx 托管 out/（gzip + 静态资源长缓存）",
        "后端 FastAPI + uvicorn 单 worker",
        "单 worker 的原因：好友连接表在进程内存",
        "聊天字体按使用频率拆成 WOFF2 分片（public/fonts/genshin/），只挂在聊天相关路由"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与内容",
      "items": [
        "对话走 OpenAI 兼容接口，换厂商只改 .env；界面为 DeepSeek 同款版式（左栏会话 + 无气泡回答 + 圆角输入区）",
        "首页是文档式聚合页：hero + 每日一句 + 随心一记快记 + 最新/最热博客 + 公开公告栏（无跳转卡片、无卡片动画）",
        "知识库 = 站内公共资料（RAGdata）+ 个人库（kb_sources 记来源，kind 区分文章与随心一记的笔记）",
        "入库按标题感知切块（块带标题路径），向量存 document_vectors；随心一记的一句话笔记单块直写、不抽图",
        "检索 = 向量召回 + 图谱一跳扩展；回答带来源引用可跳原文（笔记弹片段）；知识图谱页实时渲染「章 → 概念 → 关系」",
        "助手回复可复制 / 重新生成（只重跑最后一条，SSE 同发送）",
        "博客三态（草稿 / 仅自己 / 公开）与账号对话同库"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与入口",
      "items": [
        "登录态是 HttpOnly Cookie + auth_sessions",
        "匿名 3 句 / 每日 20 条 / 知识库 5 条 / VIP 不限；记笔记不占额度",
        "管理员（ADMIN_USERNAMES）可删任意公开文章",
        "首页对游客开放（hero / 最新 / 最热 / 公告走公开接口），随心一记需登录",
        "/knowledge 四个页签：知识库问答、随心一记（笔记增删）、知识图谱、来源管理；问答/上下文模式、使用系统知识库开关，编辑懒重建、删文/改非公开自动清理"
      ]
    }
  ]
